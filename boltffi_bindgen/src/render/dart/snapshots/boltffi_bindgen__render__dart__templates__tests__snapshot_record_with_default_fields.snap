/// A 3D Vector
/// 
/// `z` coordinate defaults to 0
final class Vector {
  /// `x` coordinate
  double x;
  /// `y` coordinate
  double y;
  /// `z` coordinate
  double z;

  Vector({
    this.z = 0,
    required this.x,
    required this.y,
  });

